/**app.wxss - 儿童友好全局样式**/
page {
  background: #FFF8F0;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #4A4A4A;
  box-sizing: border-box;
}
.container { padding: 24rpx; }

/* ── 卡通感卡片 ── */
.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 0 rgba(255, 180, 120, 0.15), 0 6rpx 20rpx rgba(255,150,150,0.08);
  border: 4rpx solid #FFF0E8;
}

/* ── 圆润弹跳按钮（按下会有回弹感）── */
.btn-primary {
  background: linear-gradient(135deg, #FFB347, #FF8A65);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 0 #E67A45;
  transition: all 0.1s;
}
.btn-primary:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #E67A45;
}
.btn-outline {
  background: #fff;
  color: #FF8A65;
  border: 4rpx solid #FFD4B8;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 0 #FFE0CC;
  transition: all 0.1s;
}
.btn-outline:active { transform: translateY(4rpx); box-shadow: 0 2rpx 0 #FFE0CC; }

.btn-success {
  background: linear-gradient(135deg, #7ED957, #4CAF50);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 0 #3D9140;
  transition: all 0.1s;
}
.btn-success:active { transform: translateY(6rpx); box-shadow: 0 2rpx 0 #3D9140; }

.btn-danger {
  background: linear-gradient(135deg, #FF9B9B, #FF6B6B);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 0 #D95555;
  transition: all 0.1s;
}
.btn-danger:active { transform: translateY(6rpx); box-shadow: 0 2rpx 0 #D95555; }

.btn-block { width: 100%; }

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  margin: 20rpx 0 16rpx;
  color: #555;
}

/* ── 空状态 ── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #BBB;
}
.empty .icon { font-size: 100rpx; margin-bottom: 20rpx; animation: float 2.4s ease-in-out infinite; }
.empty .text { font-size: 30rpx; }

/* ── 全局动画库 ── */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
@keyframes bounceIn {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.08); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg); }
  75% { transform: rotate(6deg); }
}
@keyframes popIn {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes starSpin {
  0% { transform: rotate(0deg) scale(0.5); opacity: 0; }
  50% { transform: rotate(180deg) scale(1.3); opacity: 1; }
  100% { transform: rotate(360deg) scale(1); opacity: 1; }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-10rpx); }
  40%, 80% { transform: translateX(10rpx); }
}
@keyframes fallDown {
  0% { transform: translateY(-100rpx) rotate(0deg); opacity: 1; }
  100% { transform: translateY(800rpx) rotate(360deg); opacity: 0; }
}

.anim-bounce-in { animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
.anim-pop-in { animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
.anim-wiggle { animation: wiggle 0.5s ease-in-out; }
.anim-float { animation: float 2.4s ease-in-out infinite; }
.anim-shake { animation: shake 0.4s ease-in-out; }

/* ── 通用单词列表 ── */
.word-item { padding: 24rpx; }
.wi-top { display: flex; align-items: center; justify-content: space-between; }
.wi-word { font-size: 34rpx; font-weight: 800; color: #333; }
.wi-tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; color: #fff; }
.tag-new { background: #FF8A65; }
.tag-reviewing { background: #4FC3F7; }
.tag-permanent { background: #66BB6A; }
.wi-phonetic { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }
.wi-trans { font-size: 28rpx; color: #555; display: block; margin-top: 8rpx; }

.tabs { display: flex; background: #fff; border-radius: 999rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx; font-size: 26rpx; color: #888; }
.tab-item.active { background: linear-gradient(135deg, #FFB347, #FF8A65); color: #fff; font-weight: 700; }

/* ── 彩带特效容器 ── */
.confetti-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}
/* 从天而降的那种（旧的），保留给还在用的页面 */
.confetti-piece {
  position: absolute;
  font-size: 40rpx;
  animation: fallDown 1.6s ease-in forwards;
}

/* ── 花筒彩带：屏幕下方左右两个花筒口向斜上方喷射 ── */
.confetti-cannon {
  position: absolute;
  bottom: 30rpx;
  font-size: 64rpx;
  animation: cannonPop 1.5s ease-out forwards;
}
.cc-left { left: 16rpx; transform-origin: bottom left; }
.cc-right { right: 16rpx; transform-origin: bottom right; }
@keyframes cannonPop {
  0% { transform: scale(0.3) rotate(-25deg); opacity: 0; }
  12% { transform: scale(1.25) rotate(0deg); opacity: 1; }
  60% { transform: scale(1.05) rotate(0deg); opacity: 1; }
  100% { transform: scale(0.85) rotate(6deg); opacity: 0; }
}

/* 六个喷射方向（左筒往右上、右筒往左上），每条走一个"抛上去再落下"的弧线 */
.confetti-piece.cp-d1 { animation: shootLiftA 1.5s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }
.confetti-piece.cp-d2 { animation: shootLiftB 1.55s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }
.confetti-piece.cp-d3 { animation: shootLiftC 1.45s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }
.confetti-piece.cp-d4 { animation: shootRightA 1.5s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }
.confetti-piece.cp-d5 { animation: shootRightB 1.55s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }
.confetti-piece.cp-d6 { animation: shootRightC 1.45s cubic-bezier(0.15, 0.65, 0.4, 1) forwards; }

@keyframes shootLiftA {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  35% { transform: translate(210rpx, -560rpx) rotate(200deg) scale(1); opacity: 1; }
  100% { transform: translate(360rpx, 80rpx) rotate(430deg) scale(0.9); opacity: 0; }
}
@keyframes shootLiftB {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  40% { transform: translate(110rpx, -680rpx) rotate(160deg) scale(1); opacity: 1; }
  100% { transform: translate(200rpx, -30rpx) rotate(380deg) scale(0.9); opacity: 0; }
}
@keyframes shootLiftC {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  45% { transform: translate(330rpx, -400rpx) rotate(240deg) scale(1); opacity: 1; }
  100% { transform: translate(540rpx, 140rpx) rotate(500deg) scale(0.9); opacity: 0; }
}
@keyframes shootRightA {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  35% { transform: translate(-210rpx, -560rpx) rotate(-200deg) scale(1); opacity: 1; }
  100% { transform: translate(-360rpx, 80rpx) rotate(-430deg) scale(0.9); opacity: 0; }
}
@keyframes shootRightB {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  40% { transform: translate(-110rpx, -680rpx) rotate(-160deg) scale(1); opacity: 1; }
  100% { transform: translate(-200rpx, -30rpx) rotate(-380deg) scale(0.9); opacity: 0; }
}
@keyframes shootRightC {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.5); opacity: 1; }
  45% { transform: translate(-330rpx, -400rpx) rotate(-240deg) scale(1); opacity: 1; }
  100% { transform: translate(-540rpx, 140rpx) rotate(-500deg) scale(0.9); opacity: 0; }
}
